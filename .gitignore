# Local market data (CSV stays out of Git)
data/*
!data/.gitkeep

# Any CSV anywhere
*.csv

# Quarantined legacy code: loose local copies are ignored,
# the canonical source archive under legacy/source/ is tracked.
/legacy/backtester.py
/legacy/bot.ipynb
/legacy/modifyPosition.py
/legacy/mt5.py
/legacy/stg.py
/legacy/reference/

# Synthetic test fixture is required and safe to commit
!tests/fixtures/*.csv

# Python
__pycache__/
*.pyc
.venv/

# Secrets
.env
*.pem
*.key

# Obsidian
.obsidian/workspace.json

# Generated artifacts
artifacts/*
!artifacts/.gitkeep
# Archives and raw exports must never be committed
*.rar
*.zip
*.7z
